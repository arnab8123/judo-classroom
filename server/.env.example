# Local development settings. Replace LiveKit values for production deployments.
NODE_ENV=development
PORT=3001
AUTH_SECRET=local-dev-secret-change-this
DB_PATH=./data/classroom.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CLIENT_ORIGIN=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# OAuth providers stay disabled until you create provider apps and register the
# callback URL: http://localhost:3001/api/auth/oauth/{google|microsoft|github}/callback
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
# Verify judomeet.online in Resend before sending to general recipients.
RESEND_FROM_EMAIL=Judo <verify@judomeet.online>
